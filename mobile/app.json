{
  "expo": {
    "name": "KaamConnect",
    "slug": "kaamconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F8F4"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "KaamConnect needs your location to find nearby service providers.",
          "locationWhenInUsePermission": "KaamConnect needs your location to find nearby service providers."
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KaamConnect needs your location to find nearby service providers."
      }
    },
    "android": {
      "package": "com.kaamconnect.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
